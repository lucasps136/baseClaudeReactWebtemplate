{
  "id": "payments-data",
  "name": "Payments Data",
  "version": "1.0.0",
  "category": "data",
  "description": "Data layer module for payment processing. Provides SQL schemas, TypeScript queries, and RLS policies for payment management including multiple gateways (Stripe, PagSeguro, MercadoPago), payment methods, and refund tracking.",
  "exports": {
    "schemas": [
      {
        "name": "payments_table",
        "path": "./schemas/payments.sql",
        "description": "Complete payments table with RLS policies, indexes, and triggers"
      }
    ],
    "queries": [
      {
        "name": "payments_queries",
        "path": "./queries/payments.queries.ts",
        "description": "TypeScript query library for payment CRUD operations"
      }
    ],
    "types": [
      {
        "name": "Payment",
        "path": "./queries/payments.queries",
        "description": "Payment entity interface"
      },
      {
        "name": "PaymentInsert",
        "path": "./queries/payments.queries",
        "description": "Payment creation input type"
      },
      {
        "name": "PaymentUpdate",
        "path": "./queries/payments.queries",
        "description": "Payment update input type"
      },
      {
        "name": "PaymentFilters",
        "path": "./queries/payments.queries",
        "description": "Payment filtering options"
      },
      {
        "name": "PaymentStatus",
        "path": "./queries/payments.queries",
        "description": "Payment status enum type"
      },
      {
        "name": "PaymentMethod",
        "path": "./queries/payments.queries",
        "description": "Payment method enum type"
      },
      {
        "name": "PaymentGateway",
        "path": "./queries/payments.queries",
        "description": "Payment gateway enum type"
      }
    ]
  },
  "dependencies": {
    "modules": ["user-data", "orders-data"],
    "packages": ["@supabase/supabase-js"]
  },
  "ai": {
    "summary": "Payment data layer providing SQL schemas and TypeScript queries for payment processing with multi-gateway support, payment methods (PIX, credit card, boleto), and complete transaction lifecycle management.",
    "keywords": [
      "payments",
      "payment-processing",
