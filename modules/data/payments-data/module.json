    ],
    "use_cases": [
      "Create payment records for orders",
      "Track payment lifecycle (pending → completed)",
      "Process refunds",
      "Query payments by gateway",
      "Get payment statistics for dashboards",
      "Lookup payments by external gateway ID",
      "Filter payments by method, status, date",
      "Get payer/payee payment history",
      "Store gateway responses for debugging"
    ],
    "reusable": {
      "schemas": ["payments_table"],
      "types": [
        "Payment",
        "PaymentInsert",
        "PaymentUpdate",
        "PaymentFilters",
        "PaymentStatus",
        "PaymentMethod",
