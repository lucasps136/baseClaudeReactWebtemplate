        "listPayments",
        "getPaymentsByOrder",
        "getPaymentsByPayer",
        "getPaymentsByPayee",
        "createPayment",
        "updatePayment",
        "updatePaymentStatus",
        "markAsPaid",
        "markAsFailed",
        "markAsRefunded",
        "getPaymentStats"
      ]
    },
    "examples": [
      "import { createPayment, PaymentInsert } from '@/modules/data/payments-data'",
      "const payment = await getPaymentByExternalId(supabase, stripePaymentIntentId)",
      "await markAsPaid(supabase, paymentId, externalId)",
      "const stats = await getPaymentStats(supabase, userId, 'payee')"
    ]
  },
