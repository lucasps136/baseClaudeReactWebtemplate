# Copy this file to .env and fill in your values.

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------
# Supabase Mode
# "local"  → Docker starts Supabase locally (npm run docker:up)
# "remote" → Use Supabase cloud (only Next.js starts in Docker)
# ------------------------------------------------------------
SUPABASE=local

# Supabase Configuration
# Local:  use the values below (standard Supabase CLI local dev credentials)
# Remote: get from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: override PostgreSQL password for local Docker (default: postgres)
# POSTGRES_PASSWORD=postgres

# Optional: override JWT secret for local Docker
# JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Stripe Configuration (REQUIRED)
# Get from: https://dashboard.stripe.com/test/apikeys (USE TEST KEYS ONLY)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# MCP Server API Keys (Optional - leave empty to skip these MCPs)
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Get from: https://context7.com/dashboard
CONTEXT7_API_KEY=

# Note: Supabase MCP runs locally - no access token needed